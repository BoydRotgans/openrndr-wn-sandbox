# Project-wide configuration.
#
# Copy this file to .env and fill in the values. .env is gitignored because it
# holds secrets; this template is committed so the required keys stay documented.
#
# Read it from Kotlin with Env["KEY"], Env.require("KEY") or Env.boolean("KEY").
# Real environment variables override anything set here, so you can change one
# value for a single run without editing the file.
#
# Any new credential or setting this project needs goes here — not hardcoded in
# a sketch, and not passed on the command line.

# --- Figma --------------------------------------------------------------------

# Personal access token: Figma > Settings > Security > personal access tokens
FIGMA_TOKEN=

# Paste the whole Figma url here, or just the key from
# figma.com/design/<key>/<file-name> — both work.
FIGMA_FILE_KEY=

# Which page to pull frames from, named exactly as it appears in Figma. Every frame
# on the page is exported as its own svg, in Figma's order. Leave empty for the
# file's first page.
FIGMA_PAGE=

# true re-exports the page even when data/figma already holds the frames
FIGMA_REFRESH=false

# Window size relative to the Figma frame. 1.0 is the frame's exact pixel size.
# Lower it when the frame is wider than your display.
FIGMA_WINDOW_SCALE=1.0

# Render the frame this many times larger, then downsample when presenting.
# OPENRNDR fills shapes ~1px wider per side than Figma, so type reads bold; this
# shrinks that in proportion. Measured vs Figma: 1x +5.6%, 2x +2.8%, 4x +1.4%.
# Max is 4 - 5x would exceed the 16384px texture limit on a 3840 wide frame.
FIGMA_SUPERSAMPLE=4

# --- demo01 -------------------------------------------------------------------

# true records the run to video/<name>.mp4 via ScreenRecorder. Recording uses a
# frame clock, so the sketch runs in slow motion on screen while the video comes
# out at a constant DEMO01_FPS.
DEMO01_RECORD=false

# Frame rate of that video.
DEMO01_FPS=60

# Seconds between automatic steps, for recording a clip without your hands in it.
# 0 or empty leaves the stepping to the arrow keys.
DEMO01_AUTOSTEP=0

# Stop recording and quit after this many seconds of video. Empty records until
# you close the window.
DEMO01_DURATION=

# Sheet of drawings demo02 lays out. subset.svg is the hand-picked selection;
# objects-front.svg holds all front variants, objects-iso.svg the isometric ones.
DEMO02_SHEET=data/svg/subset.svg

# Canvas demo02 composes for, and how large the window shows it. The canvas sets the
# proportion the layout works to and the size clips are recorded at; the window is
# only how much of your screen it takes up.
DEMO02_WIDTH=3840
DEMO02_HEIGHT=1080
DEMO02_WINDOW_SCALE=0.4

# Same recording controls as demo01, for demo02. Clips come out at the canvas size.
DEMO02_RECORD=false
DEMO02_FPS=60
DEMO02_AUTOSTEP=0
DEMO02_DURATION=

# --- map data -----------------------------------------------------------------

# Dutch map data comes from PDOK (BAG + BGT), which is open: no token, no account.
# There is nothing secret here, only framing.

# Which place the collected set is named after.
MAP_PLACE='s-Hertogenbosch

# Where the square extent is centred. This is geocoded, and naming the city alone is
# usually wrong: geocoding a woonplaats returns the centroid of the whole municipal
# area, which for 's-Hertogenbosch sits 2.3km north of the old town. Name a street or
# square to frame what you mean. An explicit "x,y" in RD New metres is taken as given.
MAP_CENTRE=Markt, 's-Hertogenbosch

# Half the width of the extent, in metres. 1000 gives a 2x2 km square. Ignored when
# MAP_MARGIN is set.
MAP_RADIUS=1000

# Metres of country to keep around the whole city, instead of a radius around a point.
# Set it and the extent becomes the city's own outline grown by this much, which is the
# only way to promise a margin on every side: the city is not square and not centred on
# its market square, so a radius that clears the far edge overshoots the near one.
# 5000 gives 22.1 x 20.2 km around 's-Hertogenbosch: ~200k buildings, ~160 MB, ~15 min.
# It is cached separately from the radius extent, so both can sit side by side.
MAP_MARGIN=

# Which register the ground (roads, water, nature) comes from.
#   bgt   1:500, drawn to the kerbstone. Right for a few square kilometres.
#   brt   1:10 000 (TOP10NL). Right for anything wider.
#   auto  bgt below 6 km across, brt above. This is the default.
# Buildings always come from BAG, whichever this is.
MAP_DETAIL=auto

# true re-fetches even when data/collected already holds the layers.
MAP_REFRESH=false

# --- map viewer ---------------------------------------------------------------

# MapView draws the collected data coloured by building function, as a check on it.
# Square by default, and it fits the whole extent rather than cropping it.
MAP_VIEW_WIDTH=1600
MAP_VIEW_HEIGHT=1600
MAP_VIEW_WINDOW_SCALE=0.55

# Where the view starts. Zoom is a factor on the projection, so this loses no detail.
MAP_VIEW_ZOOM=1.0

# Type size in canvas pixels. Empty scales it to the canvas (height / 62), which is what
# keeps it the same apparent size whatever MAP_VIEW_WIDTH is set to.
MAP_VIEW_TYPE=

# true writes preview.png next to the layers and quits.
MAP_VIEW_SAVE=false

# Prints a frame rate every two seconds.
MAP_VIEW_DEBUG=false

# --- city map -----------------------------------------------------------------

# Order the buildings arrive in:
#   age     the order they were really built, read off BAG's bouwjaar. The old town
#           fills in first, then the rings around it.
#   centre  outward from MAP_CENTRE, like ink spreading
#   random  shuffled, with a fixed seed so a clip is repeatable
#   reading the order the register lists them
CITY_ORDER=age

# Seconds for the whole run of buildings, and seconds for one to fade in.
# CITY_BUILDING_FADE=0 is the hard cut: a building is simply there on the frame
# it arrives, with no fade at all.
CITY_DURATION=26
CITY_BUILDING_FADE=0.9

# When the ground (roads, water, planting) starts to arrive, as a fraction of
# CITY_DURATION, and how long it takes to come up.
CITY_CONTEXT_AT=0.45
CITY_CONTEXT_FADE=5.0

# Canvas the map is composed for, and how much of the screen the window takes.
CITY_WIDTH=1920
CITY_HEIGHT=1080
CITY_WINDOW_SCALE=0.7

# cover fills the frame and crops the square extent; contain fits the whole extent
# inside it, letterboxed.
CITY_FIT=cover

# CITY_FOCUS holds the frame on a named point rather than on the middle of the
# extent — "x,y" in RD metres, or a place to geocode. It decides how far the shot
# may pull back, since the distance to the nearest edge of the data is what binds.
CITY_FOCUS=

# Where the view starts. Zoom is a factor on the projection, so this loses no detail.
CITY_ZOOM=1.0

# A flight. Setting CITY_ZOOM_FROM starts the shot pulled right in and pulls back to
# CITY_ZOOM_TO over CITY_DURATION. The reveal is then tied to the zoom rather than the
# clock: buildings appear in proportion to the area the camera can see, so they land one
# at a time while close in and flood in as the view widens. The centre never moves — the
# shot is a straight pull-back around the middle of the extent.
#
# Pick the starting zoom from the data, not by eye. Consecutive arrivals in age order are
# a median 165 m apart, so a frame narrower than that skips most of them: 4 gives a 600 m
# view on a 2 km extent, where a 12 m building still reads 77 px wide at 4K.
CITY_ZOOM_FROM=
CITY_ZOOM_TO=1.0

# The opening: this many buildings arrive at an even, countable rate over this many
# seconds with the zoom held still, before the pull-back starts.
CITY_OPENING_COUNT=12
CITY_OPENING_TIME=8

# true keeps the ground up from the first frame instead of fading it in later, so the
# rivers are there the whole way.
CITY_GROUND_ALWAYS=false

# Every building up from the first frame too, so the shot is the camera move and
# nothing else. A flight then runs either way: CITY_ZOOM_FROM above CITY_ZOOM_TO
# pulls back off one element, below it pushes in on the whole city.
CITY_BUILDINGS_ALWAYS=false

# The closing beats. CITY_GRID takes the elements in the frame the push comes to
# rest on and stands them in a grid; CITY_LAST then empties that grid one element
# at a time until only the one nearest the middle is left.
# _AT is when each begins in seconds, _TIME how long it takes. CITY_GRID_MAX caps
# how many elements take part, CITY_GRID_FILL how much of a cell one may fill, and
# CITY_LAST_ORDER is far (outside in), near, file or random.
# CITY_LAST_INK picks the survivor out in its own colour; unset leaves it alike.
CITY_GRID=false
CITY_GRID_MAX=120
CITY_GRID_FILL=0.8
CITY_LAST=false
CITY_LAST_ORDER=far
# CITY_LAST_SCALE grows the survivor as the rest go; 1 leaves it as packed.
CITY_LAST_SCALE=1

# Which ground layers are drawn at all, from nature, water and roads. Leaving one out
# skips loading and triangulating it, which is most of the work — the road surfaces alone
# are 8.5M of the 8.6M vertices in the 2 km extent, so water-only loads in half a second
# rather than four.
# Use none for no ground at all; an empty value here reads as unset and gives the default.
CITY_GROUND_LAYERS=nature,water,roads

# Ground and figure. Empty CITY_GROUND_LAYERS with these two inverted gives the buildings
# alone, white on black.
CITY_PAPER=#FFFFFF
CITY_INK=#000000

# What the buildings are drawn as.
#   footprints  their own outlines
#   objects     Willy Naessens elements packed onto the plan they stand on
CITY_FABRIC=footprints

# The catalogue to pack from, and the height of one element on the ground in metres.
# The size is the control that matters: it sets both how many elements the map holds and
# how coarse the grain is. A house takes one or two, a warehouse takes dozens, so the
# count is roughly the precast pieces that plan would really need.
# subset.svg is the hand-picked selection with more profile to the shapes; objects-iso.svg
# holds all 115 isometric variants, many of which are plain slabs and hairlines — and is
# what an unset key falls back to, whatever this line happens to say.
#
# The size is also a legibility floor, not just a grain: on a 2 km extent at zoom 1 an 8 m
# element is about 8 px and the town reads as texture rather than as components. 18 keeps
# the whole extent and still lets a single piece be seen.
CITY_OBJECT_SHEET=data/svg/subset.svg
CITY_OBJECT_SIZE=8
CITY_OBJECT_GAP=1
CITY_OBJECT_MAX=48

# Where a recorded clip is written.
CITY_VIDEO=video/citymap.mp4

# Same recording controls as the demos. Clips come out at the canvas size.
CITY_RECORD=false
CITY_FPS=60
CITY_VIDEO_DURATION=

# Writes this many stills evenly across the timeline and quits, instead of running.
CITY_STILLS=0

# Prints a frame rate every two seconds.
CITY_DEBUG=false

# --- decision -----------------------------------------------------------------

# The two keyframes. non-decided.svg is where the dots and lines start, decided.svg
# where they end up; the sketch pairs them by colour and moves one dot per step. Both
# are exported from Figma, so the composition is changed there and not in the code.
DECISION_UNDECIDED=data/svg/non-decided.svg
DECISION_DECIDED=data/svg/decided.svg

# What stands at each decision. Naming a sheet — the same precast elements demo02 lays out —
# stands one of its drawings at each dot, in that dot's colour: the svgs place and colour the
# decisions and the sheet says what they are. `none` draws the dots as the plain circles they
# are in the svg instead, which is the piece exactly as designed.
#
# It has to be the word `none` and not an empty value: Env reads blank as unset, and unset
# falls back to the sheet.
DECISION_SHEET=data/svg/subset.svg

# Which drawings off that sheet, counted in its reading order and reused in turn if there
# are fewer than there are dots. Unset takes them in sheet order, which on these sheets is
# a run of plain slabs that all read alike. 0,5,8,12 are the gable, the T panel, the corner
# and the doorway — four silhouettes you can tell apart at a glance.
DECISION_OBJECTS=0,5,8,12

# How much larger than the dot it replaces an element is drawn. It scales the gathering by
# the same factor — the decided positions are pushed out from the point they gather on — so
# this enlarges the composition that was drawn rather than piling the elements up in it. A
# dot is 70 units across and they gather 116 apart, so 1.0 is a smudge.
#
# It is also the control that decides whether the piece still reads as a convergence, which
# is only visible in motion: the scattered state is a fixed 513x376 whatever this is set to,
# so scaling the gathering shrinks the difference between the two. 1.0 tightens 4.4x, 2.0
# tightens 2.2x, 3.0 only 1.5x — at which point the elements barely move and the clip reads
# as a shuffle. 2.0 is the trade: 140 unit elements that still visibly gather.
# Both keys are ignored when DECISION_SHEET is `none`.
DECISION_OBJECT_SCALE=3.0

# What is put on the paper, overriding the colours in the svgs. Those colours are never
# actually replaced — they are what pairs the shapes across the two drawings and what ties
# each line to the dots that move it — so this changes the ink and nothing else.
#
# One value paints everything alike: FFFFFF is the black and white version. Several are
# handed out to the colours in the order the drawing introduces them, so FFFFFF,7A7A7A
# keeps the two groups apart in tone rather than in hue, which is worth having because the
# colour is what says why a line moves when it does. Leave it empty to draw as designed.
DECISION_INK=FFFFFF

# The ground. Empty takes it from the svg, which is black. DECISION_PAPER=FFFFFF alongside
# DECISION_INK=000000 gives the inverted version, black on white.
DECISION_PAPER=

# The order the dots decide in:
#   near    the smallest move first, so the outlier is the last to come round (default)
#   far     the biggest move first
#   file    the order the svg lists them
#   random  shuffled, with a fixed seed so a clip is repeatable
DECISION_ORDER=near

# Canvas the piece is composed for, and how much of the screen the window takes. The
# drawing is fitted to the canvas, so this is a size and never a different composition.
DECISION_WIDTH=1920
DECISION_HEIGHT=1080
DECISION_WINDOW_SCALE=0.7

# Same recording controls as the demos. Clips come out at the canvas size.
DECISION_RECORD=false
DECISION_FPS=60
DECISION_AUTOSTEP=0
DECISION_DURATION=

# true writes one png per resting state to screenshots/ and quits, which is how to
# judge a change to the keyframes without filming it. Ignores DECISION_AUTOSTEP.
DECISION_STILLS=false

# --- handover -----------------------------------------------------------------

# Two sets of crosses taking the floor from one another. One set is white on black paper and
# the other black on white; a wave over the lattice turns whichever set's turn it is by a
# quarter, and because a cross has four-fold symmetry it lands back exactly where it started.
# The two sets tile the plane, so at the moment of the handover the two polarities are the
# same picture and it can be thrown without anything moving.

# Canvas, and how large the window shows it. Square by default.
HANDOVER_WIDTH=1080
HANDOVER_HEIGHT=1080
HANDOVER_WINDOW_SCALE=0.75

# How many units tall the frame is. A cross arm is one unit wide and three long, so this is
# really how many crosses fit: 15 gives about five across.
HANDOVER_SCALE=15

# Seconds for the whole cycle. It is also exactly the length of a seamless loop, so a clip
# left to its own duration joins to itself.
HANDOVER_PERIOD=24

# How much the wave leans as it crosses the lattice. 0 runs it flat along the rows; 0.3 sets
# it at the diagonal.
HANDOVER_SLOPE=0.3

# What stands on the lattice. `none` is the cross the construction is built on. A sheet
# stands one of its drawings there instead — which costs the polarity, because a panel is
# not a shape that tiles: see the note in CLAUDE.md.
HANDOVER_SHEET=data/svg/subset.svg

# Which drawing, counted in the sheet's reading order. Empty picks one at random from
# HANDOVER_SEED, and space steps to the next one while it runs.
HANDOVER_OBJECT=
HANDOVER_SEED=1

# How much of the cross's box a panel is allowed. A cross is only five ninths of its box and
# meets its neighbours at the arm tips alone; a panel is solid to its corners, so at full
# size it runs into the next one along the lattice and the two read as one mass.
HANDOVER_FIT=0.85

# How far a pass turns a tile, in degrees. 90 for the cross, because that is its own symmetry
# and puts it back exactly. A panel has no symmetry, so 360 is the only angle that leaves no
# trace of the wave — but 90 works too and reads quite differently: the turn is kept rather
# than undone, and the frame fills with bands of panels standing at 0, 90, 180 and 270. That
# takes four passes to come back round, so the loop is then four periods long.
HANDOVER_TURN=360

# Paper and ink. With a panel both sets are ink on paper, so swapping these inverts the piece.
HANDOVER_PAPER=#F0EEE9
HANDOVER_INK=#141414

# Same recording controls as the other sketches. Left unset, the duration is one full loop.
HANDOVER_RECORD=false
HANDOVER_FPS=60
HANDOVER_DURATION=

# Writes a single png of the frame at this many seconds and quits. Empty just runs it.
HANDOVER_SAVE=

# --- objects -----------------------------------------------------------------------------
# One piece of the catalogue at a time, in the round. J and K step through the folder.

# Where the meshes are. `data/objects` is the 115 precast concrete pieces; `data/unique_objects`
# is the whole building they came out of — 388 unique shapes standing for 89 410 instances,
# with ducts, bolts and cable tray in it, and a manifest.csv beside them.
OBJECTS_DIR=data/objects

# Which piece to open on, by name rather than index so it survives a change of folder.
# WAND_27 is a wall panel with a doorway: nearly 16:9, and the piece that proves the loader,
# since that opening only survives because the faces are ear-clipped rather than fanned.
OBJECTS_START=WAND_27

# Degrees a second the piece turns on its own. 0 holds it still; space pauses it.
OBJECTS_SPIN=0

# Vertical field of view. Lower is a longer lens: less perspective, flatter, more elevation-like.
OBJECTS_FOV=40

OBJECTS_PAPER=#000000
OBJECTS_INK=#1D1D1B

OBJECTS_WIDTH=1920
OBJECTS_HEIGHT=1080
OBJECTS_WINDOW_SCALE=0.75

# Writes the opening piece to screenshots/ and quits.
OBJECTS_STILL=false

# Draws every piece in the folder into one contact sheet and quits. This is how to choose a
# piece: sorting on face count picks a smooth disc, because a finely cut round profile counts
# the same as real articulation. The eye settles in a second what the sort cannot.
OBJECTS_CONTACT=false
OBJECTS_CONTACT_COLUMNS=12

# A colour per side. Left empty the hues step by a golden angle, which keeps them distinct
# however many faces a piece has. A comma-separated list of hex values is cycled instead,
# e.g. the brand pair: OBJECTS_PALETTE=#FF0000,#5E00FF
OBJECTS_PALETTE=

# How much the light varies a face's colour. The colours tell the sides apart, so this stays
# low; 0 is wholly flat.
OBJECTS_SHADE=0.35

# Every real edge is drawn twice — a dark line on the edge and a lighter one just inside it.
# The pair reads against a face of any colour, which one line alone cannot. Widths in pixels.
OBJECTS_EDGE_DARK=#000000
OBJECTS_EDGE_LIGHT=#FFFFFF
OBJECTS_EDGE_WIDTH=2
OBJECTS_EDGE_LIGHT_WIDTH=2

# Isometric by default: an orthographic projection at 45 degrees and an elevation of
# atan(1/sqrt 2), which is what makes the three axes foreshorten equally. `perspective` gives
# a normal camera back, which is the better one for judging a piece as an object rather than
# as a drawing. OBJECTS_YAW / OBJECTS_PITCH override the angles either way.
OBJECTS_PROJECTION=iso
OBJECTS_YAW=
OBJECTS_PITCH=

# The piece repeated across an irregular grid. Q and A add and drop a column, W and S add and
# drop a row; 1 x 1 is the single object. Columns and rows take their widths from a fixed
# seed, so the field has a beat to it rather than reading as graph paper.
OBJECTS_GRID_X=1
OBJECTS_GRID_Y=1
OBJECTS_GRID_MARGIN=0.80
OBJECTS_GRID_SEED=1
# How unequal the columns and rows are: a cell gets 1 +/- half of this as its share
# of the axis, so 0.8 runs 0.6x to 1.4x of the average. 0 makes the spacing even.
OBJECTS_GRID_JITTER=0.8

# How far two faces have to turn before the edge between them is drawn, in degrees. This is
# not cosmetic: the exporter writes a face with a hole as two coplanar polygons meeting along
# a seam, and without this WAND_33 gets two long diagonals across a blank panel.
OBJECTS_CREASE=1

# The name, size and count under the piece. Off, so what is on the paper is the drawing and
# nothing else; true is worth having when stepping through a folder of 115.
OBJECTS_CAPTION=false

# Records the run to video/. The clip captures the session — stepping with J K, growing the
# grid with Q A W S — rather than a set piece, so it is as long as you leave it unless
# OBJECTS_DURATION caps it. Note OBJECTS_SPIN=0 means a clip of an untouched window is a
# still image; turn the spin up or drive it from the keyboard.
OBJECTS_RECORD=false
OBJECTS_FPS=60
OBJECTS_DURATION=
OBJECTS_VIDEO=video/objects.mp4

# How the geometry is drawn. `poster` is the soft one: three tones taken from which way a
# face points, a gradient down the whole piece, no outlines, a graded ground and a blurred
# shadow. `line` is the black-and-white technical drawing with every real edge inked.
OBJECTS_STYLE=poster
OBJECTS_TOP=#FFFFFF
OBJECTS_LEFT=#F1F1F2
OBJECTS_RIGHT=#DEDEE1
OBJECTS_PAPER_SHADE=#000000
OBJECTS_FACE_GRADIENT=0.10

# The shadow is the piece sheared flat onto the floor it stands on, blurred and laid under it.
OBJECTS_SHADOW=#8A93A6
OBJECTS_SHADOW_STRENGTH=0
OBJECTS_SHADOW_SOFTNESS=9
OBJECTS_SHADOW_SLANT=0.55

# Lettering laid over the faces, tiled and slowly travelling across them. `none` leaves the
# surfaces bare. These meshes carry no texture coordinates — they are structural components,
# not models made for rendering — so the shader uses a face's own two in-plane object
# coordinates as its uv. That is what makes the word run on across a corner rather than
# being fitted to each face, and it is why the u axis has to be flipped by the sign of the
# normal: taken raw it comes out mirrored on every face pointing down a negative axis.
OBJECTS_TEXT=WILLY NEASENS
OBJECTS_TEXT_INK=#FF0000
# How much of the piece one repeat covers. Smaller means bigger type.
OBJECTS_TEXT_SCALE=1.0
# Repeats a second. 0.05 crosses one repeat in twenty seconds.
OBJECTS_TEXT_SPEED=0.05

# The face for the lettering. data/fonts holds one weight of IBM Plex and no bold, so a bold
# has to come from outside the project; a path that does not resolve falls back to the
# bundled font rather than stopping the run.
OBJECTS_TEXT_FONT=/System/Library/Fonts/Supplemental/Rockwell.ttc

# Which face to lift out, when the font is a collection. Most macOS fonts are: one file
# holds Regular, Italic, Bold and Bold Italic, and stb_truetype will not open one at all,
# so the named face is written out as a standalone font under build/ and that is loaded.
OBJECTS_TEXT_FONT_FACE=Rockwell Bold

# The space between one piece and the next, across and down, where the GUI sliders start.
# Measured against the piece rather than the frame, so it means the same thing whatever is
# being shown. Empty falls back to OBJECTS_GRID_GAP for both, which is the even spacing.
OBJECTS_GAP_X=
OBJECTS_GAP_Y=

# Off, every copy in the grid carries the same word in the same place, so the field reads as
# one piece repeated. On, each copy gets the lettering that belongs to where it stands: its
# uv is shifted by the cell's own position, so all of them are windows onto a single text
# plane lying behind the whole field, and the words run on across the gaps as one line.
OBJECTS_TEXT_CONTINUOUS=true

# The concrete map laid over the faces (poster style). `none` leaves them flat.
#
# It is used as grain rather than as colour: the shader takes it against the map's own mean
# brightness and modulates the face tone with it, so the three tones that tell the sides
# apart survive and the piece does not simply become the colour of the photograph. That mean
# is measured off the pixels at load, because the two maps here sit at 0.59 and 0.81 and a
# hardcoded middle would shift every face the moment the other one was picked.
OBJECTS_CONCRETE=data/concrete/concrete-052v2_crop.jpg
# Object units one repeat of the map covers, and how strongly it varies the tone.
OBJECTS_CONCRETE_SCALE=0.9
OBJECTS_CONCRETE_AMOUNT=1.0

# How many lines of lettering go into one tile. Drawn into the tile rather than got by
# shrinking the type, because one line per tile spaces the lines by the tile — they could
# only ever be as far apart as they are wide. A `|` in OBJECTS_TEXT puts different words on
# different lines, e.g. WILLY NAESSENS|PRECAST|BETON.
OBJECTS_TEXT_ROWS=1

# --- PowerPoint export (tools/figma_to_pptx.py) --------------------------------
# Turns a Figma page of slides into a .pptx with real PowerPoint speaker notes.
# Reuses FIGMA_TOKEN and FIGMA_FILE_KEY above.
PPT_PAGE=SHEETS - SPEAKER NOTES
# Slide size in px. The page mixes 1920x1080 and 3908x1080 frames and a pptx has
# one size, so anything wider than this letterboxes rather than being cropped.
PPT_WIDTH=1920
PPT_HEIGHT=1080
# Export scale for the rendered PNGs. 2 gives 192 dpi on a 20in slide.
PPT_SCALE=2
# px-to-inch for the slide size. 144 makes 1920x1080 come out 13.333x7.5in,
# which is PowerPoint's own widescreen size.
PPT_DPI=144
# The ground behind a letterboxed slide, and of any slide that fails to render.
PPT_BACKGROUND=000000
# Frames with this prefix hold the speaker notes; notes-2-04 belongs to slide 2-04.
PPT_NOTE_PREFIX=notes-
# Put each chapter card in as a section-divider slide.
PPT_CHAPTER_SLIDES=true
# Rendered PNGs are cached here, so re-running costs no export and no network.
# Frames per image request, and how long to wait for Figma to render them.
# A wide frame at 2x is slow server side; small batches make progress visible
# and mean a timeout costs one batch rather than the whole run.
PPT_BATCH=5
PPT_TIMEOUT=300
PPT_CACHE=export/pptx-images
PPT_REFRESH=false
PPT_OUT=export/wn-speaker-notes.pptx

# --- slideshow ----------------------------------------------------------------

# The show is declared in src/main/kotlin/slideshow/Slideshow.kt — canvas, window,
# chapters and slides, all in that one file. The keys below override it for a
# single run; leave one empty and the show's own value stands. Run it with
#     ./gradlew run -Popenrndr.application=SlideshowKt

# Which slide to open on: a number counting from 1, or a slide's name
# ("3" and "Loop" both work). Empty starts at the first.
SLIDES_START=

# Open with the debug overlay up — slide, click, frame, loop phase and the whole
# deck along the bottom. `d` toggles it either way.
SLIDES_DEBUG=false

# The canvas everything is composed at, and how much of the screen the window
# takes. Everything is drawn into one render target at this size and the window
# only shows that image, so the preview, a still and a recorded frame are the
# same pixels at different sizes and the composition never changes with the
# window. 3840x1080 is the two-pane frame the show declares — 1920 for the
# chapter card and 1920 for the slide, side by side. Slides that size off the
# height compose at any of these.
#
# This overrides canvas(...) in Slideshow.kt, so it has to carry the panel and
# its gutter too: with panel(width = 1920, gap = 0), anything other than 3840
# here is taken out of the slide's own pane, not out of the card's.
SLIDES_WIDTH=3840
SLIDES_HEIGHT=1080
SLIDES_WINDOW_SCALE=0.5

# Present on the whole display. The canvas is fitted into it rather than
# stretched, so a projector of another shape letterboxes instead of distorting.
SLIDES_FULLSCREEN=false

# Putting the show on a wall of projectors. FULLSCREEN takes one display, so a
# 3840x1080 canvas spanning two of them is an *undecorated* window placed across
# both — decorations would also push the canvas down by the title bar's height.
# WINDOW_X/_Y are in screen points, not pixels: the offset to a display beside a
# Retina laptop is that laptop's logical width. Read the arrangement with
#   osascript -e 'tell application "Finder" to get bounds of window of desktop'
# which gives the union of every display; subtract the projectors' width from it.
# Run with SLIDES_WINDOW_SCALE=1.0 so the canvas is 1:1 on the wall. `esc` quits,
# which is the only way out of an undecorated window.
SLIDES_UNDECORATED=false
SLIDES_WINDOW_X=
SLIDES_WINDOW_Y=
SLIDES_TITLE=openrndr

# Seconds between automatic clicks, for recording a run hands-off. 0 or empty
# leaves the clicking to the keys. Stepping is counted in frames, so a recorded
# run steps at exactly this rate however slowly the encoder keeps up.
SLIDES_AUTOSTEP=0

# A written run instead: seconds to hold at each stop before clicking on, one number
# per click, in order. SLIDES_AUTOSTEP's single interval cannot film this deck — a
# click of the city takes twelve seconds and a click of the stack takes half of one,
# so any interval that lets the first finish holds the second twenty times too long.
# Wins over SLIDES_AUTOSTEP when set; when the list runs out the deck stops where it
# is. This one films the first chapter:
#   SLIDES_CUES=5, 4, 14, 6, 3, 6, 16, 3, 2.5, 2.5, 2.5, 2.5, 5
SLIDES_CUES=

# Same recording controls as the other sketches. Clips come out at the canvas size.
SLIDES_RECORD=false
SLIDES_FPS=60
SLIDES_DURATION=

# Write one png per click of every slide to screenshots/ and quit: the whole deck
# as a contact sheet, which is how to check a change without clicking through it.
SLIDES_STILLS=false

# --- one slide on its own: SlideStudio ------------------------------------- #
#
#   ./gradlew run -Popenrndr.application=SlideStudioKt
#
# The drawer to work on rather than the show to click through, and the twin of
# CardStudio for the other half of the canvas. Only the slide you ask for loads:
# present() loads all thirteen and the four mosaic cards before the first frame,
# because a show must not hitch on a click — measured, about 3s against 0.1-0.3s
# for one slide. The seconds are the smaller half of it, though. What it really
# saves is no clicking to reach the slide, a window the size of the pane rather
# than a 3840 canvas beside a card you are not working on, and stills scoped to
# the one drawer. up/down load a neighbour when first asked for.
#
# ->/<- are the clicks, up/down the slides, r replays, p holds the clock and . ,
# step it, s writes a still, d the overlay, esc quits.

# Which slide: a number from 1, or any of the three things a slide can be called —
# its name (Cut), its class (HardCutSlide) or its title in the running order
# (catalogue). The class matters because every drawer overrides name, and detailing
# one means navigating by file. Empty falls back to SLIDES_START, then to slide 1.
SLIDE=

# How much of the screen the window takes. Empty inherits SLIDES_WINDOW_SCALE, so
# one dial sets the studio and the talk together and a drawer is detailed at the
# size it is projected.
SLIDE_WINDOW=

# Onto the wall, the way the show goes: an undecorated window placed by hand,
# because fullscreen takes one display and the show spans two. Empty inherits
# SLIDES_UNDECORATED and SLIDES_WINDOW_X/_Y — and the studio is offset a chapter
# card's width along, so it stands on the slide's own projector rather than the
# card's. Set X/Y outright for one projector rather than two. esc is the only way
# out of an undecorated window.
SLIDE_UNDECORATED=
SLIDE_WINDOW_X=
SLIDE_WINDOW_Y=

# One png per click of this slide to screenshots/, then quit.
SLIDE_STILLS=false
# Or the frames at these seconds into the slide's own clock, then quit — which is
# how to judge a drawer that moves, where a single still says nothing about the
# order things arrived in.
SLIDE_AT=

# Seconds between automatic clicks, for filming it hands-off.
SLIDE_AUTOSTEP=0
SLIDE_RECORD=false
SLIDE_FPS=60
SLIDE_DURATION=

# --- sound ------------------------------------------------------------------ #
#
# Where the evening's cues live. WN-0909 is the sound design as delivered:
# numbered one-shots, a base-loop bed and a clic. A path, so it is here; which
# cue a chapter opens on is content and is stated in Slideshow.kt (chapterSound).
SLIDES_SOUNDS=data/sounds/WN-0909

# Whether the deck makes any sound: the cues a slide or a chapter card declares.
# Off for a rehearsal, or on a machine where the audio should not go out — and it
# is a load switch as well as a mute, so off opens no device and decodes nothing.
# A stills run is silent whatever this says.
SLIDES_SOUND=true

# --- backdrops -------------------------------------------------------------- #
#
# The pictures around the talk: the wall before it and after it, taking both
# projectors with no chapter card beside them. Declared in Slideshow.kt with
# backdrop(...) and drawn in slideshow/backdrop-drawers/. What each one stands on
# the wall — which elements, in which colours — is content and is stated in the
# show; the sheet those elements come off is a path, so it is here.
SLIDES_BACKDROP_SHEET=data/svg/subset.svg

# The opening wall draws the whole catalogue rather than a hand-picked few, so it
# reads its own sheet. objects-iso.svg is all 115 pieces drawn isometrically and
# is what the wall runs; objects-front.svg is the same catalogue in elevation, 112
# of them, and mostly plain silhouettes — a slab really is a rectangle there, which
# is the asset rather than a fault. data/svg/subset.svg is the picked few.
SLIDES_OPENING_SHEET=data/svg/objects-iso.svg

# The concrete the filled pieces are cut out of on the opening wall. It is sampled
# in canvas pixels rather than in the piece's own space, so the texture is nailed
# to the wall and a piece is a window onto it: the stone does not slide when the
# piece slides, and two pieces side by side are cut from one slab. Empty fills flat.
SLIDES_OPENING_TEXTURE=data/concrete/concrete-052v2_crop.jpg

# The catalogue's own register: one row a piece, in the sheet's reading order, with
# the name, the assembly it belongs to, its IFC class and profile, and its box in
# millimetres — the depth especially, which no silhouette can give you. It is paired
# with the sheet **by index and only when the counts agree**, so it belongs with the
# 115-piece iso sheet; pointed at the 112 the front sheet recovers, the details are
# dropped rather than shifted one place from the first gap onwards.
SLIDES_OPENING_DETAILS=data/csv/objects-115-details.csv

# The conveyor walls read the elevations: a piece on a belt is seen square on, and
# the iso sheet is drawn at an angle. The register lines up with either — see
# `alignedTo`, which knows the front sheet is the same 115 rows minus three.
SLIDES_BELT_SHEET=data/svg/subset.svg

# The family the whole talk is set in, in two weights. data/fonts holds one weight
# of IBM Plex and no bold, so it comes from the machine — and Rockwell lives in a
# .ttc collection, which loadFont will not open at all: usableFont lifts the named
# face out into a standalone font under build/. Name the face exactly. The
# collection holds "Rockwell-Bold" and "Rockwell Bold Italic", and a loose match
# takes the italic. An unusable file falls back to the bundled face rather than
# stopping the show.
SLIDES_FONT=/System/Library/Fonts/Supplemental/Rockwell.ttc
SLIDES_FONT_BOLD=Rockwell-Bold
SLIDES_FONT_TEXT=Rockwell

# The chapter cards' own face. A card's title is never drawn as type — it is drawn
# into a plate and rebuilt out of catalogue elements — so what the face decides is
# the shape of the strokes the mosaic fills. A grotesque comes apart into parts
# better than a slab does. Empty falls back to the deck's own bold, so a machine
# without this face still runs the show. SLIDES_CARD_FACE names a face inside a
# .ttc; a plain .ttf needs none.
SLIDES_CARD_FONT=
SLIDES_CARD_FACE=

# What the chapter cards are built out of. These are ObjectChapterPanel's own
# constructor defaults, so a value tried in CardStudio is the value the show runs
# with — there is no second set of numbers to keep in step.
#
# COARSE is the cell every mark stands in. FINEST is how far a cell may quarter
# itself where it straddles the edge of a letter — left empty it equals COARSE, so
# every element on the card is one size, the grey ground included. Set it below
# COARSE and the packing comes back: a stroke fills with big elements and its edge
# traces with small ones, and the size of a mark tells you where in the letter it is.
# In the studio, j and k step the mark size live.
#
# SHRINK is how big an element standing outside the words is against one standing
# inside them: the size is what carries the letters, not the colour. A mark swells as
# a word reaches it and settles back as the word goes past, so the field breathes
# with the type instead of only changing tone under it. 1 leaves every mark one size
# and hands the letters back to the colour alone.
#
# THRESHOLD is how much of a cell has to be inked for it to stand in the ink rather
# than in the ground, and it is what a coarse grid is steered with. A mark can only
# be as big as the stroke it has to fill: at 18 pane pixels a stroke of this type
# carries two or three marks across and the letters read, at 34 barely one, and past
# that no cell is ever wholly inside a stroke and the words come apart. Lowering it
# lights cells the letters only clip, which puts weight back at the cost of the words
# growing into their own counters. Big marks want big letters — a one-word chapter,
# or `lines` in the show — rather than a lower threshold. SHAPE is the cell's wide-to-high, and left empty it is read off the
# sheet — the median of its own objects — rather than assumed. It has to be, because
# the sheets differ: subset.svg runs 1.85 and objects-iso.svg 1.06, and an element
# fitted into a cell of another proportion letterboxes, so naming a sheet without
# this would quietly halve the ink. FILL is how much of its cell an element takes,
# so the rest is the air around the mark.
SLIDES_CARD_COARSE=30
SLIDES_CARD_FINEST=
SLIDES_CARD_SHAPE=
SLIDES_CARD_FILL=0.9
SLIDES_CARD_THRESHOLD=0.32
SLIDES_CARD_SHRINK=0.3

# The ground is packed as well as the letters, so the whole card is catalogue and
# the words are the part of it picked out in ink. It is cut out by the words
# wherever they are — a cell reads the same picture for its size and its colour —
# so a letter always carries its own edge against the field. A hex value, or `none`
# for a bare card: the word rather than an empty value, because Env reads blank as
# unset and unset has to keep meaning the ground the card was designed with.
SLIDES_CARD_GROUND=343434
SLIDES_CARD_INK=#FFFFFF
SLIDES_CARD_PAPER=#000000

# The arrival, in seconds: REVEAL is how long the elements take to land, one after
# another, and POP is how long one takes to grow from nothing once its number comes
# up. The card takes REVEAL + POP in all, so the last one finishes growing too.
SLIDES_CARD_REVEAL=1.2
SLIDES_CARD_POP=0.3

# The catalogue the marks come from. Falls back to CITY_OBJECT_SHEET.
SLIDES_CARD_SHEET=data/svg/subset.svg

# --- a picture instead of type: ObjectImageChapterPanel ------------------------- #
#
# The same field of elements, reading a picture off disk rather than type the card
# sets itself — so a title that was drawn rather than set can still be made of
# components. The picture must be **white on black** (white is ink, black is ground)
# and is fitted into the pane, never cropped or stretched; INVERT reads a picture
# that is the other way round. Every SLIDES_CARD_* key above still applies to the
# field, because nothing downstream of the plate changes.
SLIDES_CARD_IMAGE=data/slides/chapter0.png
SLIDES_CARD_IMAGE_INVERT=false
# Clearance between neighbouring marks, in pane pixels, at every level of the grid.
SLIDES_CARD_GAP=2
# The picture's black and white points, lo,hi, applied to the plate before the field
# reads it. Empty leaves it alone.
SLIDES_CARD_LEVELS=
# How much ink a cell needs to count as wholly inside a stroke. 0.88 is the strict
# default; lower lets a mostly-covered cell stand at its own size.
SLIDES_CARD_SOLID=0.88
# The arrival. 0 is the field's baked random order, every cell independent. 1 stages
# it in two passes: the ground sweeps up from the foot over STAGE of the reveal, then
# after DELAY the ink sweeps down from the head over what is left — the wall built
# first and the words landing onto it. Both are shares of the whole arrival.
SLIDES_CARD_SWEEP=1.0
SLIDES_CARD_STAGE=0.45
SLIDES_CARD_DELAY=0.12

# The drift: the title is repainted into a black and white plate every frame and the
# field of elements reads it, so the type can move while the field stands still. The
# lines of the title are laid one under another and repeated across, every other row
# mirrored, the whole thing travelling slowly upward and breathing between the two
# zooms below.
#
# The type never changes size: what moves is where each word stands — every line on a
# slow circle of SHIFT line-heights, each from its own phase, so no two are quite in
# line or in step. A circle rather than a there-and-back, so nothing accelerates and
# there is no turn to see.
#
# PERIOD is seconds for one whole turn, so a clip that long loops exactly. 0 holds the
# title still, which is the card as a plain title card.
#
# DEBUG draws the plate itself instead of the field that reads it, with every box the
# layout stands on over it: the buffer's own edge in red, the measure the type is set
# to in orange, how far a word may hang off in yellow, the window's band in green and
# each word's own box in blue. `b` in the studio switches between the two. They are
# the same card at two stages, which is the point — a fault in the picture and a fault
# in the packing that reads it look alike until the picture can be seen on its own,
# and a word in the wrong place looks exactly like a word correctly placed in a box
# that is itself wrong.
#
# BUILD sets the sentence out a word at a time and takes it away again a word at a
# time, in the order it is read; HOLD is how many beats the whole sentence stands
# before it starts going. The places are the opening deal's and never change — what
# happens is that the words arrive and leave. A word eases in by being drawn fainter
# on the plate, so a half-drawn word is a half-grown mark under it and the elements
# swell into the letters rather than the letters fading on. The card sets its own loop
# from this: a beat a word in, HOLD beats standing, a beat a word out.
#
# With BUILD off the arrangement holds and the words readjust instead, one at a time.
# BEAT is seconds between readjustments and MOVE is how long one takes. One word at a
# time eases to somewhere new and the others hold exactly where they are, so the card
# is a still arrangement that readjusts now and then rather than a field in motion —
# and with only one box ever moving, "never overlapping" is cheap to guarantee: the
# place it lands and the whole box it sweeps on the way are tested against the words
# standing still. The opening arrangement is dealt at the largest size that seats
# every word clear of every other, and that size is then held for the life of the
# card. The last round sends every word home, so a clip of PERIOD loops.
#
# BLEED is how far a word may hang off the frame, as a fraction of its own size, and
# it is what lets the type be bigger than the card: held inside, a word can only be as
# large as the frame's narrowest way of seating them all; allowed past the edge it is
# set two or three times that and cropped, which is what the reference does and what
# makes the letters read as shapes rather than as a word centred in a box. 0 keeps
# every word whole. The words still never overlap each other — it is the frame they
# are allowed past, not one another.
#
# WINDOW is the height of the box the type is seen through, as a fraction of the card,
# and it travels from below the frame to above it and back over one PERIOD. Nothing
# outside it reaches the plate, so a word is uncovered as the window passes and gone
# again behind it — the field standing at its resting size wherever the window is not.
# It is a clip on the picture, not on the elements: they never move, they are simply
# reading a plate that has type on it for as long as the window is over them. 0 shows
# the whole card at once.
#
# TILE repeats the sentence across and down until it fills the frame, the way the
# reference does, and TURNS then sends the strip travelling that many cycles a period
# (the lines come round every n rows and the mirroring every two, so after their lcm
# the picture is itself again). Off, the sentence is set once where it belongs:
# repeated copies each wandering on their own circle read as the *type* changing size,
# and the eye takes that for a zoom.
SLIDES_CARD_PERIOD=40
SLIDES_CARD_SHIFT=0
SLIDES_CARD_BEAT=2.0
SLIDES_CARD_MOVE=0.4
SLIDES_CARD_BUILD=true
SLIDES_CARD_DEBUG=false
SLIDES_CARD_HOLD=2
SLIDES_CARD_BLEED=0.5
SLIDES_CARD_WINDOW=0
SLIDES_CARD_TILE=false
SLIDES_CARD_TURNS=0

# Flip every other row so the rows meet foot to foot, the way the reference does.
# Off: there the repeated word is a texture and a flipped copy reads as a
# reflection, where these rows are the chapter's own words and one standing on its
# head reads as a mistake. Worth having on a one-word title.
SLIDES_CARD_MIRROR=false

# CardStudio.kt runs one chapter card on its own at 1920x1080 — the card to work on
# rather than the show to click through, and only the cards load, so startup is a
# second rather than the deck's ten.
#
#     ./gradlew run -Popenrndr.application=CardStudioKt
#
#     -> <-  the next card and the one before, each replayed from its first frame
#     r      replay this one     p  hold the clock,  . and , step it a frame
#     s      write this frame to screenshots/        d  the readout
#
# CARD picks which card it opens on, counting from 1, or the start of a chapter's
# name. CARD_WINDOW is how much of the screen the window takes — 1.0 is one canvas
# pixel to one screen pixel, and the canvas is fitted into the window rather than
# stretched to it whatever it is set to.
CARD=
CARD_WINDOW=1.0

# CARD_STILLS writes a png and quits: of the card CARD names, or of every card when
# it names none. CARD_AT=6,14 writes the frames at those seconds instead — two of
# them a period apart is how the drift's loop is checked, since a png is lossless
# where a clip's own compression noise is louder than the difference being looked
# for. CARD_RECORD films instead — one chapter to a run, since ScreenRecorder writes
# a file per program, so filming four cards is CARD=1 … 4.
CARD_STILLS=false
CARD_AT=
CARD_RECORD=false
CARD_FPS=60
CARD_DURATION=4

# --- ImageCardStudio: the picture-backed card on its own ------------------------ #
#
#   ./gradlew run -Popenrndr.application=ImageCardStudioKt
#
# What the card is made of is stated *here* rather than taken from SLIDES_CARD_*
# above: those are the typeset card's, tuned for a 1.85:1 cell off subset.svg, and a
# picture wants none of it — square marks or the letterforms smear, a visible ground
# or there is nothing for the words to be cut out of. These defaults are the recipe
# that matches the reference sketch. CARD_WINDOW and CARD_STILLS are shared with
# CardStudio; SLIDES_CARD_IMAGE above still names the picture.
CARD_SHEET=data/svg/subset.svg
# Which pieces of the sheet, by index. Empty is all of them.
CARD_OBJECTS=
# The quadtree: big pieces through the middle of a stroke, small ones tracing its
# edge. COARSE over FINEST is how many sizes the wall is built from.
CARD_COARSE=32
CARD_FINEST=8
# Empty takes the sheet's own median, so a piece fills its cell rather than
# letterboxing in one of another proportion.
CARD_SHAPE=
CARD_FILL=1.0
# Clearance held between neighbours in pane pixels, whatever size they are. FILL is a
# fraction of the cell and so cannot hold this: it leaves a hairline between two fine
# marks and a chasm between two coarse ones.
CARD_GAP=2
CARD_UNIFORM=false
# 1 stands every piece full size, inside the letters and out, so the words are
# carried by colour alone and the wall stays a wall.
CARD_SHRINK=1.0
CARD_THRESHOLD=0.32
# How much ink a cell needs to count as *wholly inside* a stroke, and so to stand at
# its own size instead of handing the place to four smaller cells. The default 0.88
# is strict: over a thin stroke no coarse cell reaches it, so the word is drawn in
# the smallest marks the field has while the ground stands in the largest.
CARD_SOLID=0.62
# The picture's black and white points, applied to the plate before the field reads
# it. chapter0.png sets WERELD and BOUWEN in solid white but DE and VAN in soft grey,
# so without this the same letters carry a third of the signal and stand in ground.
CARD_LEVELS=0.06,0.38
# Longer than the typeset card's 1.2s: there are two passes and a pause in this one.
CARD_REVEAL=2.8
CARD_SWEEP=1.0
CARD_STAGE=0.45
CARD_DELAY=0.12
# Seconds into the card's own clock to write a png at, then quit. The only way to
# judge a reveal — one still says nothing about the order things arrived in.
CARD_AT=
CARD_INK=#FFFFFF
CARD_GROUND=#2E2E2E
CARD_TITLE=De wereld van bouwen
CARD_SUB=

# --- kinetic type -------------------------------------------------------------------
#
# KineticType.kt is the type on its own: a sentence set as separate words, dealt across
# the frame so none of them touch, and read out a word at a time.
#
#     ./gradlew run -Popenrndr.application=KineticTypeKt
#
# `b` outlines the boxes the deal gave the words, esc quits. The chapter card stands
# the same thing up in catalogue elements — it paints this into a plate and a field of
# components reads it — and the two share the file, so a change to how the words fall
# is a change to both.
KINETIC_TEXT=De wereld van bouwen
KINETIC_WIDTH=1920
KINETIC_HEIGHT=1080
KINETIC_WINDOW_SCALE=1.0
KINETIC_INK=#FFFFFF
KINETIC_PAPER=#000000
KINETIC_INSET=70

# BEAT is seconds between words arriving, MOVE how long one takes to arrive or go, and
# HOLD how many beats the whole sentence stands before it starts clearing. The turn is
# derived from those and the word count, and a clip of it loops. BLEED is how far a
# word may hang off the frame, as a fraction of its own size — what lets the type be
# set bigger than the frame and be cropped. Never more than half, whatever is asked.
KINETIC_BEAT=2.0
KINETIC_MOVE=0.4
KINETIC_HOLD=2
KINETIC_BLEED=0.5
KINETIC_LEADING=0.95
KINETIC_BOXES=false

# RECORD films one turn — the length is the turn itself, since that is what loops.
# STILL=t writes the frame at t seconds and quits.
KINETIC_RECORD=false
KINETIC_FPS=60
KINETIC_DURATION=
KINETIC_STILL=

# --- CircleMosaic: the mosaic field with a growing circle behind it -------------- #
#
#   ./gradlew run -Popenrndr.application=CircleMosaicKt
#
#     j / k  the mark size      b  the plate the field reads     r  restart
#     p      hold the clock, . and , step it                     s  a still
#
# ObjectImageChapterPanel's field reading a plate that is painted a frame at a time
# rather than loaded off disk: one white circle growing out of the middle. The field
# never knew it was reading letters, so a circle is the same thing to it.
#
# Its own keys rather than SLIDES_CARD_* — those are the typeset card's, tuned for a
# ground that barely shows, and here the ground has to stand or the piece is a disc on
# empty paper rather than a circle passing through a field.
CIRCLE_SHEET=data/svg/subset.svg
# Which pieces of the sheet, by index. Empty is all of them.
CIRCLE_OBJECTS=
# The quadtree: big marks through the middle of the disc, small ones tracing its edge.
CIRCLE_COARSE=64
CIRCLE_FINEST=16
# The cell's wide-to-high. Empty takes the sheet's own median, which is what stops a
# mark letterboxing in a cell of another proportion.
CIRCLE_SHAPE=
CIRCLE_FILL=0.88
CIRCLE_GAP=2
CIRCLE_UNIFORM=false
CIRCLE_SEED=0

# How the circle runs. PERIOD is one swing in seconds; RETURN grows it and brings it
# back, so the loop closes with nothing to cut — false is the plain sawtooth. OVER is
# how far past the frame's furthest corner it grows, so >1 holds a full field for a
# moment at the top. CENTRE is where it stands, as a fraction of the frame.
CIRCLE_PERIOD=6
CIRCLE_RETURN=true
CIRCLE_OVER=1.0
CIRCLE_CENTRE=0.5,0.5

# Inside the circle a mark stands full size in INK; outside it, SHRINK of that in
# GROUND. SHRINK=1 hands the whole job to colour.
CIRCLE_INK=#FFFFFF
CIRCLE_GROUND=#454545
CIRCLE_PAPER=#000000
CIRCLE_SHRINK=0.45
CIRCLE_THRESHOLD=0.32
CIRCLE_SOLID=0.88

# The field arriving, once, before the circle starts: REVEAL is the whole of it and
# POP how long one mark takes to grow from its own centre.
CIRCLE_REVEAL=1.2
CIRCLE_POP=0.3

# DEBUG (or b) draws the plate itself rather than the field that reads it.
CIRCLE_WINDOW=1.0
CIRCLE_DEBUG=false
CIRCLE_STILLS=false
CIRCLE_AT=
CIRCLE_RECORD=false
CIRCLE_FPS=60
CIRCLE_DURATION=
